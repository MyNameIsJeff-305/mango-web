---
import MainLayout from "../layouts/MainLayout.astro";
import { seoLandingPages } from "../data/seoPages";
import { ArrowRight, CheckCircle2, Sparkles } from "@lucide/astro";

export function getStaticPaths() {
    return seoLandingPages.map((page) => ({
        params: {
        slug: page.slug,
        },
        props: {
        page,
        },
    }));
}

const { page } = Astro.props;
---

<MainLayout
    title={page.title}
    description={page.description}
    ogImage="/images/branding/mango-og.webp"
    schemaType="Service"
>
    <main class="overflow-hidden">
        <section class="section-shell relative">
        <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
            <div class="absolute -top-32 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-[rgb(var(--color-mango-yellow)/0.18)] blur-3xl"></div>
            <div class="absolute right-0 top-32 h-96 w-96 rounded-full bg-[rgb(var(--color-mango-pink)/0.16)] blur-3xl"></div>
        </div>

        <div class="container-shell grid gap-12 lg:grid-cols-[1fr_0.7fr] lg:items-center">
            <div>
            <p class="section-kicker">
                <Sparkles class="size-4" aria-hidden="true" />
                {page.eyebrow}
            </p>

            <h1 class="mt-5 max-w-5xl text-balance">
                {page.heroTitle}
            </h1>

            <p class="lead mt-6 max-w-3xl">
                {page.heroDescription}
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a href={page.ctaHref} class="btn btn-primary">
                {page.ctaLabel}
                <ArrowRight class="size-4" aria-hidden="true" />
                </a>

                <a href="/portfolio" class="btn btn-secondary">
                View Our Work
                </a>
            </div>
            </div>

            <aside class="glow-panel rounded-[var(--radius-brand)] p-6">
            <p class="text-sm font-black uppercase tracking-[0.18em] text-[rgb(var(--color-mango-pink))]">
                SEO Focus
            </p>

            <h2 class="mt-3 text-2xl">
                {page.primaryKeyword}
            </h2>

            <div class="mt-5 grid gap-3">
                {page.secondaryKeywords.map((keyword) => (
                <div class="flex items-start gap-3 rounded-2xl border border-[rgb(var(--color-border)/0.3)] bg-[rgb(var(--color-surface)/0.55)] p-4">
                    <CheckCircle2 class="mt-0.5 size-5 shrink-0 text-[rgb(var(--color-leaf-teal))]" />
                    <p class="text-sm font-bold text-[rgb(var(--color-text-soft))]">
                    {keyword}
                    </p>
                </div>
                ))}
            </div>
            </aside>
        </div>
        </section>

        <section class="section-shell-sm">
        <div class="container-shell grid gap-6 md:grid-cols-2">
            {page.sections.map((section) => (
            <article class="glow-panel rounded-[var(--radius-brand)] p-7">
                <h2 class="text-2xl">{section.title}</h2>
                <p class="mt-4 leading-7 text-[rgb(var(--color-text-soft))]">
                {section.content}
                </p>
            </article>
            ))}
        </div>
        </section>

        <section class="section-shell-sm">
        <div class="container-shell">
            <div class="mx-auto max-w-3xl text-center">
            <p class="section-kicker mx-auto">
                <CheckCircle2 class="size-4" aria-hidden="true" />
                Why it matters
            </p>

            <h2 class="mt-5">
                Built for visibility, trust, and conversion.
            </h2>
            </div>

            <div class="mt-10 grid gap-5 md:grid-cols-3">
            {page.benefits.map((benefit) => (
                <article class="glow-panel rounded-[var(--radius-brand)] p-6">
                <h3 class="text-xl">{benefit.title}</h3>
                <p class="mt-3 leading-7 text-[rgb(var(--color-text-soft))]">
                    {benefit.description}
                </p>
                </article>
            ))}
            </div>
        </div>
        </section>

        <section class="section-shell-sm">
        <div class="container-shell">
            <div class="glow-panel rounded-[var(--radius-brand)] p-7 md:p-10">
            <p class="section-kicker">
                Questions
            </p>

            <h2 class="mt-4">
                Frequently asked questions about {page.serviceName.toLowerCase()}.
            </h2>

            <div class="mt-8 grid gap-4">
                {page.faqs.map((faq) => (
                <details class="rounded-2xl border border-[rgb(var(--color-border)/0.35)] bg-[rgb(var(--color-surface)/0.55)] p-5">
                    <summary class="cursor-pointer font-black text-[rgb(var(--color-heading))]">
                    {faq.question}
                    </summary>
                    <p class="mt-3 leading-7 text-[rgb(var(--color-text-soft))]">
                    {faq.answer}
                    </p>
                </details>
                ))}
            </div>
            </div>
        </div>
        </section>

        <section class="section-shell-sm">
        <div class="container-shell">
            <div class="glow-panel text-center rounded-[var(--radius-brand)] p-8 md:p-12">
            <p class="section-kicker mx-auto">
                Mango Media
            </p>

            <h2 class="mx-auto mt-5 max-w-3xl">
                Want to turn your website into a stronger local growth asset?
            </h2>

            <p class="lead mx-auto mt-5 max-w-2xl">
                Let’s review your current online presence and identify where your website, SEO, and social media can work harder for your business.
            </p>

            <div class="mt-8 flex justify-center">
                <a href="/contact" class="btn btn-primary">
                Request a Free Review
                <ArrowRight class="size-4" aria-hidden="true" />
                </a>
            </div>
            </div>
        </div>
        </section>
    </main>
</MainLayout>