---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { siteConfig } from "../data/site";

import FloatingGoFundMe from "../components/ui/FloatingGoFundMe.astro";

type SchemaObject = Record<string, unknown>;

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  showGoFundMeWidget?: boolean;
  schemaType?:
    | "Organization"
    | "LocalBusiness"
    | "Service"
    | "Article"
    | "WebPage";
  schemaData?: SchemaObject;
  schema?: SchemaObject | SchemaObject[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  canonical,
  noindex = false,
  showGoFundMeWidget = true,
  schemaType = "WebPage",
  schemaData = {},
  schema,
} = Astro.props;

const currentUrl = canonical
  ? new URL(canonical, siteConfig.siteUrl).toString()
  : new URL(Astro.url.pathname, siteConfig.siteUrl).toString();

const absoluteOgImage = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteConfig.siteUrl).toString();

const robots = noindex ? "noindex, nofollow" : "index, follow";

const logoUrl = new URL(
  "/images/branding/logo-square.webp",
  siteConfig.siteUrl,
).toString();

const baseOrganizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteConfig.siteUrl}/#organization`,
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.siteUrl,
  logo: logoUrl,
  image: absoluteOgImage,
  description: siteConfig.description,
  email: siteConfig.email,
  telephone: siteConfig.phone,
  sameAs: siteConfig.socialLinks,
};

const baseLocalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteConfig.siteUrl}/#localbusiness`,
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.siteUrl,
  image: absoluteOgImage,
  logo: logoUrl,
  description: siteConfig.description,
  email: siteConfig.email,
  telephone: siteConfig.phone,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    addressLocality: siteConfig.address.locality,
    addressRegion: siteConfig.address.region,
    addressCountry: siteConfig.address.country,
  },
  areaServed: siteConfig.areaServed.map((area) => ({
    "@type": "Place",
    name: area,
  })),
  knowsAbout: siteConfig.services,
  sameAs: siteConfig.socialLinks,
};

const baseWebsiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteConfig.siteUrl}/#website`,
  name: siteConfig.siteName,
  url: siteConfig.siteUrl,
  publisher: {
    "@id": `${siteConfig.siteUrl}/#organization`,
  },
};

const baseWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${currentUrl}#webpage`,
  name: title,
  description,
  url: currentUrl,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}/#website`,
  },
  about: {
    "@id": `${siteConfig.siteUrl}/#localbusiness`,
  },
};

const defaultSchemaByType = {
  Organization: {
    ...baseOrganizationSchema,
    ...schemaData,
  },

  LocalBusiness: {
    ...baseLocalBusinessSchema,
    ...schemaData,
  },

  Service: {
    "@context": "https://schema.org",
    "@type": "Service",
    name: title,
    description,
    provider: {
      "@id": `${siteConfig.siteUrl}/#localbusiness`,
    },
    areaServed: siteConfig.areaServed.map((area) => ({
      "@type": "Place",
      name: area,
    })),
    ...schemaData,
  },

  Article: {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    image: absoluteOgImage,
    mainEntityOfPage: currentUrl,
    author: {
      "@id": `${siteConfig.siteUrl}/#organization`,
    },
    publisher: {
      "@id": `${siteConfig.siteUrl}/#organization`,
    },
    ...schemaData,
  },

  WebPage: {
    ...baseWebPageSchema,
    ...schemaData,
  },
};

const selectedDefaultSchema =
  defaultSchemaByType[schemaType] ?? defaultSchemaByType.WebPage;

const customSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const structuredData = [
  baseOrganizationSchema,
  baseLocalBusinessSchema,
  baseWebsiteSchema,
  baseWebPageSchema,
  selectedDefaultSchema,
  ...customSchemas,
];

const uniqueStructuredData = structuredData.filter((item, index, array) => {
  const itemId = item["@id"];

  if (!itemId) return true;

  return (
    array.findIndex((schemaItem) => schemaItem["@id"] === itemId) === index
  );
});
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5Z2HPXQ39P"
    ></script>

    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-5Z2HPXQ39P");
    </script>

    <script type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "wn4ke3w9eq");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={currentUrl} />

    <meta
      property="og:type"
      content={schemaType === "Article" ? "article" : "website"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:image" content={absoluteOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <meta name="theme-color" content="#f4f4f2" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (() => {
        const storageKey = "mango-theme";
        const root = document.documentElement;
        const metaTheme = document.querySelector('meta[name="theme-color"]');

        const getSystemTheme = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";

        const applyTheme = (theme) => {
          root.classList.remove("light", "dark");
          root.classList.add(theme);
          root.dataset.theme = theme;

          if (metaTheme) {
            metaTheme.setAttribute(
              "content",
              theme === "dark" ? "#0f1115" : "#f4f4f2",
            );
          }
        };

        try {
          const storedTheme = localStorage.getItem(storageKey);
          const initialTheme = storedTheme || getSystemTheme();
          applyTheme(initialTheme);

          window.__setPreferredTheme = (theme) => {
            localStorage.setItem(storageKey, theme);
            applyTheme(theme);
          };

          window.__getPreferredTheme = () => root.dataset.theme || initialTheme;

          window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", (event) => {
              const stored = localStorage.getItem(storageKey);
              if (!stored) {
                applyTheme(event.matches ? "dark" : "light");
              }
            });
        } catch {
          applyTheme("light");
        }
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(uniqueStructuredData)}
    />
  </head>

  <body
    class="bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))] font-montserrat antialiased transition-colors duration-300"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[rgb(var(--color-surface))] focus:px-4 focus:py-2 focus:text-[rgb(var(--color-text))]"
    >
      Skip to content
    </a>

    <div
      class="relative min-h-screen overflow-x-clip bg-[rgb(var(--color-bg))]"
    >
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(circle_at_top_left,rgba(254,205,76,0.20),transparent_35%),radial-gradient(circle_at_top_right,rgba(176,241,34,0.14),transparent_30%),radial-gradient(circle_at_center,rgba(218,60,120,0.10),transparent_45%)]"
      >
      </div>

      <Header />

      <main id="main-content" class="relative">
        <slot />
      </main>

      <Footer />

      {showGoFundMeWidget && <FloatingGoFundMe />}
    </div>
  </body>
</html>
